{% extends 'base.html.twig' %}

{% block title %}Connexion - FitBooking{% endblock %}

{% block body %}
<div class="bg-[#E5BA5A] min-h-screen flex flex-col items-center justify-center px-4 py-8">
    
    <div class="flex flex-col items-center mb-8">
        <div class="w-28 h-28 mb-4 bg-black rounded-full flex items-center justify-center overflow-hidden shadow-lg border border-black">
            <img src="{{ asset('images/logoo.png') }}" alt="Logo FitBooking" class="w-full h-full object-cover">
        </div>
        <h1 class="text-4xl font-extrabold text-black tracking-wide drop-shadow-md">FitBooking</h1>
    </div>

    <h2 class="text-3xl font-semibold text-black mb-6 text-center">Connexion</h2>

    <form method="post" class="w-full max-w-sm space-y-5">
        
        {# Affichage des erreurs de connexion #}
        {% if error %}
            <div class="p-3 bg-red-100 text-red-700 rounded-lg text-sm border border-red-300">
                Identifiants incorrects. Veuillez réessayer.
            </div>
        {% endif %}

        <div>
            <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus
                   placeholder="Email"
                   class="w-full px-4 py-3 bg-[#D9D9D9] border border-gray-400 rounded-xl shadow-[inset_0_2px_4px_rgba(0,0,0,0.2)] text-gray-700 placeholder-gray-500 focus:outline-none">
        </div>

        <div>
            <input type="password" name="_password" id="password" autocomplete="current-password" required
                   placeholder="Mot de passe"
                   class="w-full px-4 py-3 bg-[#D9D9D9] border border-gray-400 rounded-xl shadow-[inset_0_2px_4px_rgba(0,0,0,0.2)] text-gray-700 placeholder-gray-500 focus:outline-none">
        </div>

        {# Jeton CSRF #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="w-full py-3 mt-2 bg-[#2D2D30] text-white font-semibold uppercase tracking-wider rounded-xl shadow-md hover:bg-[#1E1E20] transition duration-200">
            Connexion
        </button>

        <div class="text-center mt-6">
            <a href="{{ path('app_register') }}" class="text-xs font-semibold text-black underline hover:text-gray-800">
                Pas de compte ? Créer un compte.
            </a>
        </div>
    </form>
</div>
{% endblock %}