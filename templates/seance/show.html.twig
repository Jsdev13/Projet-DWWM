{% extends 'base.html.twig' %}

{% block title %}{{ seance.name }} - FitBooking{% endblock %}

{% block body %}
<div class="bg-[#4d2f35] text-white min-h-screen pb-28 font-sans max-w-md mx-auto shadow-2xl">

    {# 1. Image selon la séance #}
    <div class="h-64 w-full overflow-hidden relative bg-gray-900">
        <img 
            src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=600&auto=format&fit=crop" 
            alt="{{ seance.name }}" 
            class="w-full h-full object-cover"
        />
    </div>

    <div class="px-5 py-6">

        {# 2. TITRE #}
        <h1 class="text-3xl font-extrabold tracking-wide mb-6 leading-tight font-sans">
            {{ seance.name }}
        </h1>

        {# 3. CARTES D'INFOS  #}
        <div class="grid grid-cols-3 gap-3 mb-6">
            
            <!-- Durée calculée à partir des heures de début et fin -->
            <div class="bg-white text-gray-900 rounded-lg p-3 text-center flex flex-col items-center justify-center shadow-md">
                <svg class="w-6 h-6 text-gray-700 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9" stroke-width="2"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 7v5l3 3"/>
                </svg>
                <span class="text-[11px] text-gray-500 font-medium leading-none mb-1">Horaire</span>
                <span class="text-xs font-black leading-tight">
                    {{ seance.startTime ? seance.startTime|date('H:i') : '' }} - {{ seance.endTime ? seance.endTime|date('H:i') : '' }}
                </span>
            </div>

            <!-- Coach (Affiche le nom du coach s'il existe) -->
            <div class="bg-white text-gray-900 rounded-lg p-3 text-center flex flex-col items-center justify-center shadow-md">
                <svg class="w-6 h-6 text-gray-700 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <span class="text-[11px] text-gray-500 font-medium leading-none mb-1">Coach</span>
                <span class="text-xs font-black leading-tight truncate w-full">
                    {{ seance.coach ? seance.coach.nom : 'Non assigné' }}
                </span>
            </div>

            <!-- Niveau (utilise seance.level) -->
            <div class="bg-white text-gray-900 rounded-lg p-3 text-center flex flex-col items-center justify-center shadow-md">
                <svg class="w-6 h-6 text-gray-700 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
                <span class="text-[11px] text-gray-500 font-medium leading-none mb-1">Niveau</span>
                <span class="text-xs font-black leading-tight">{{ seance.level }}</span>
            </div>

        </div>

        {# 4. INFORMATIONS COMPLÉMENTAIRES #}
        <div class="mb-6">
            <h2 class="text-lg font-extrabold mb-3 text-white">
                À propos de cette séance
            </h2>
            <div class="text-xs text-gray-200 leading-relaxed space-y-3 font-normal">
                <p>
                    Rejoignez-nous pour la séance de <strong>{{ seance.name }}</strong> du {{ seance.date ? seance.date|date('d/m/Y') : '' }}. 
                    Capacité maximale : <strong>{{ seance.capacityMax }} personnes</strong>.
                </p>
            </div>
        </div>

        {# 5. SALLE / LIEU #}
        <div class="mb-8">
            <h2 class="text-lg font-extrabold mb-3 text-white">
                Lieu
            </h2>
            <div class="inline-flex items-center bg-white text-gray-900 px-4 py-2 rounded-lg font-bold text-xs shadow-md space-x-2">
                <svg class="w-4 h-4 text-gray-800" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M3 3a1 1 0 000 2h1v12H3a1 1 0 100 2h14a1 1 0 100-2h-1V5h1a1 1 0 100-2H3zm5 2h4v12H8V5zm2 5a1 1 0 100 2 1 1 0 000-2z"/>
                </svg>
                <span>{{ seance.salle ? seance.salle.nom : 'Salle principale' }}</span>
            </div>
        </div>

        {# 6. BOUTON RÉSERVER #}
        <form action="{{ path('app_seance_reserver', {'id': seance.id}) }}" method="POST">
            <button 
                type="submit" 
                class="block w-full text-center bg-black hover:bg-gray-900 text-white font-black text-lg uppercase py-4 rounded-xl shadow-xl transition transform active:scale-95 tracking-widest cursor-pointer"
            >
                Réserver
            </button>
        </form>

    </div>

</div>
{% endblock %}