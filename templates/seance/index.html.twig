{% extends 'base.html.twig' %}

{% block title %}Cours disponibles - FitBooking{% endblock %}

{% block body %}
{# Conteneur principal : max-w-md sur mobile, max-w-6xl sur PC #}
<div class="bg-[#E5BA5A] min-h-screen text-black pb-28 pt-2 px-4 md:px-8 max-w-md md:max-w-6xl mx-auto relative transition-all duration-300">

    {# Entête : Titre + Bouton Jours #}
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl md:text-3xl font-black tracking-tight text-gray-900">Cours disponibles</h1>
        <button id="open-calendar-modal-btn" class="flex items-center space-x-2 bg-black/10 hover:bg-black/20 px-4 py-2 rounded-xl text-xs md:text-sm font-black text-gray-900 transition cursor-pointer">
            <svg class="w-4 h-4 md:w-5 md:h-5 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span id="calendar-btn-label">Jours</span>
            <svg class="w-3.5 h-3.5 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
    </div>

    {# Calendrier horizontal (5 jours) #}
    <div id="quick-days-container" class="grid grid-cols-5 gap-2 md:gap-4 mb-6"></div>

    {# Recherche + Filtre (Côte à côte) #}
    <div class="flex items-center space-x-2 mb-6">
        <div class="relative flex-1">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input 
                type="text" 
                id="search-input"
                placeholder="Rechercher un cours...." 
                class="w-full pl-9 pr-3 py-2 bg-white rounded-lg text-xs font-medium text-gray-800 placeholder-gray-500 focus:outline-none shadow-sm"
            >
        </div>
        <div class="relative">
            <select 
                id="category-filter" 
                class="appearance-none bg-white pl-3 pr-7 py-2 rounded-lg text-xs font-bold text-gray-800 focus:outline-none shadow-sm cursor-pointer uppercase"
            >
                <option value="all">Toutes</option>
                {% if categories is defined and categories is not empty %}
                    {% for cat in categories %}
                        {% set catVal = cat.nom is defined ? cat.nom : (cat.name is defined ? cat.name : cat.id) %}
                        <option value="{{ catVal|lower }}">{{ cat.nom is defined ? cat.nom : (cat.name is defined ? cat.name : 'Catégorie') }}</option>
                    {% endfor %}
                {% else %}
                    <option value="musculation">Musculation</option>
                    <option value="boxe">Boxe</option>
                    <option value="cardio">Cardio</option>
                {% endif %}
            </select>
            <svg class="w-3.5 h-3.5 absolute right-2 top-1/2 -translate-y-1/2 text-gray-800 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
        </div>
    </div>

    {# LISTE DES COURS : Responsive #}
    <div id="seances-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 min-h-[500px] items-start">
        
        {% for seance in seances %}
            {% set catName = seance.categorie ? (seance.categorie.nom is defined ? seance.categorie.nom : (seance.categorie.name is defined ? seance.categorie.name : seance.categorie)) : 'Général' %}
            {% set catId = seance.categorie ? (seance.categorie.id is defined ? seance.categorie.id : '') : '' %}
            {% set nbReservations = seance.reservations is defined ? seance.reservations|length : 0 %}
            {% set maxPlaces = seance.capacityMax|default(10) %}
            {% set placesRestantes = maxPlaces - nbReservations %}
            {% set estPlein = placesRestantes <= 0 %}
            {% set seanceId = seance.id is defined ? seance.id : loop.index %}
            {% set seanceDate = seance.date ? seance.date|date('Y-m-d') : 'today' %}

            <div class="seance-card bg-white rounded-xl p-3 shadow-md border border-gray-100 flex flex-col justify-between h-full"
                 data-title="{{ seance.name|lower }}" 
                 data-category="{{ catName|lower }}"
                 data-category-id="{{ catId }}"
                 data-date="{{ seanceDate }}">
                <div>
                    <div class="flex items-center justify-between text-[11px] font-extrabold tracking-wider text-gray-500 mb-2">
                        <div class="flex space-x-1.5 items-center">
                            <span class="bg-gray-200 px-2 py-0.5 rounded text-gray-700 uppercase">{{ catName }}</span>
                            
                            {% if seance.startTime and seance.endTime %}
                                {% set diff = seance.endTime.diff(seance.startTime) %}
                                {% set dureeMin = (diff.h * 60) + diff.i %}
                                <span class="bg-gray-200 px-2 py-0.5 rounded text-gray-700">{{ dureeMin }} min</span>
                            {% endif %}
                        </div>
                        
                        {% if estPlein %}
                            <span class="uppercase text-red-600 font-extrabold">PLEIN</span>
                        {% else %}
                            <span class="uppercase text-gray-800">{{ placesRestantes }} PLACES RESTANTES</span>
                        {% endif %}
                    </div>

                    <div class="flex space-x-3 items-center my-3">
                        <div class="w-20 h-20 bg-gray-200 rounded-lg overflow-hidden flex-shrink-0 flex items-center justify-center">
                            {% if seance.image is defined and seance.image %}
                                <img src="{{ seance.image }}" alt="{{ seance.name }}" class="w-full h-full object-cover">
                            {% else %}
                                <div class="w-full h-full bg-[#232323] text-white flex items-center justify-center">
                                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                </div>
                            {% endif %}
                        </div>
                        <div class="min-w-0 flex-1">
                            <h2 class="course-title text-lg font-black text-gray-900 leading-tight break-words">{{ seance.name }}</h2>
                            <p class="text-xs font-semibold text-gray-500 mt-1">
                                {% if seance.startTime and seance.endTime %}
                                    {{ seance.startTime|date('H:i') }} - {{ seance.endTime|date('H:i') }}
                                {% else %}
                                    Horaire non défini
                                {% endif %}
                            </p>
                            <p class="text-xs font-bold text-black mt-1">
                                Coach : {{ seance.coach ? (seance.coach.nom is defined ? seance.coach.nom : seance.coach) : 'JONATHAN SETIAO' }}
                            </p>
                        </div>
                    </div>
                </div>

                <div>
                    <hr class="border-gray-200 my-2">

                    <div class="flex space-x-2 pt-1">
                        {% set dejaReserve = false %}
                        {% if app.user and seance.reservations is defined %}
                            {% for res in seance.reservations %}
                                {% set resMember = res.member is defined ? res.member : (res.user is defined ? res.user : null) %}
                                {% if resMember == app.user %}
                                    {% set dejaReserve = true %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}

                        {% if dejaReserve %}
                            <button disabled class="flex-1 bg-green-600 text-white font-black py-2 rounded-lg text-xs tracking-wider uppercase cursor-not-allowed">
                                DÉJÀ RÉSERVÉ
                            </button>
                        {% elseif estPlein %}
                            <button disabled class="flex-1 bg-gray-200 text-gray-500 font-black py-2 rounded-lg text-xs tracking-wider uppercase cursor-not-allowed">
                                PLEIN
                            </button>
                        {% else %}
                            {% if app.user %}
                                <form action="{{ path('app_seance_reserver', {'id': seanceId}) }}" method="POST" data-turbo="false" class="flex-1">
                                    <button type="submit" class="w-full bg-black text-white font-black py-2 rounded-lg text-xs tracking-wider uppercase hover:bg-gray-800 transition">
                                        REJOINDRE
                                    </button>
                                </form>
                            {% else %}
                                <a href="{{ path('app_login') }}" class="flex-1 text-center bg-black text-white font-black py-2 rounded-lg text-xs tracking-wider uppercase hover:bg-gray-800 transition">
                                    REJOINDRE
                                </a>
                            {% endif %}
                        {% endif %}

                        <a href="{{ path('app_seance_show', {'id': seanceId}) }}" 
                           class="w-9 h-9 flex items-center justify-center border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-100 transition flex-shrink-0"
                           title="Voir les détails">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-span-full p-6 text-center text-xs font-bold text-gray-700">
                Aucune séance disponible pour le moment.
            </div>
        {% endfor %}

        {# Message si aucun résultat #}
        <div id="no-results" class="col-span-full hidden text-center py-8 text-gray-800 font-extrabold">
            Aucune séance ne correspond à votre recherche.
        </div>

    </div>
</div>

{# MODALE CALENDRIER #}
<div id="calendar-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center hidden">
    <div class="bg-white w-full max-w-md rounded-t-3xl sm:rounded-2xl p-5 text-gray-900 shadow-2xl">
        <div class="flex items-center justify-between mb-4 border-b pb-3">
            <h3 class="text-lg font-black tracking-tight">Choisir une date</h3>
            <button id="close-calendar-modal" class="w-8 h-8 flex items-center justify-center bg-gray-100 rounded-full text-gray-600 hover:bg-gray-200 font-bold">✕</button>
        </div>

        <div class="text-center font-black text-sm uppercase tracking-wider text-gray-500 mb-3" id="current-month-label"></div>

        <div class="grid grid-cols-7 text-center font-bold text-xs text-gray-400 mb-2">
            <span>Dim</span><span>Lun</span><span>Mar</span><span>Mer</span><span>Jeu</span><span>Ven</span><span>Sam</span>
        </div>

        <div id="month-grid" class="grid grid-cols-7 gap-1.5 text-center mb-4 max-h-64 overflow-y-auto"></div>

        <button id="close-modal-confirm" class="w-full bg-black text-white font-black py-3 rounded-xl text-xs uppercase tracking-wider shadow-lg">
            Valider
        </button>
    </div>
</div>

<script>
function initSeancesPage() {
    const quickDaysContainer = document.getElementById('quick-days-container');
    if (!quickDaysContainer) return;

    const calendarModal = document.getElementById('calendar-modal');
    const openModalBtn = document.getElementById('open-calendar-modal-btn');
    const closeModalBtn = document.getElementById('close-calendar-modal');
    const confirmModalBtn = document.getElementById('close-modal-confirm');
    const monthGrid = document.getElementById('month-grid');
    const currentMonthLabel = document.getElementById('current-month-label');
    const calendarBtnLabel = document.getElementById('calendar-btn-label');
    
    const searchInput = document.getElementById('search-input');
    const categoryFilter = document.getElementById('category-filter');
    const cards = document.querySelectorAll('.seance-card');
    const noResults = document.getElementById('no-results');

    const daysFr = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];
    const monthsFr = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
    
    let activeDate = null; 

    // Pré-sélection via paramètre URL (?categorie=musculation ou ?categorie=boxe)
    const urlParams = new URLSearchParams(window.location.search);
    const selectedCatFromUrl = urlParams.get('categorie');
    if (selectedCatFromUrl && categoryFilter) {
        const catUrlLower = selectedCatFromUrl.toLowerCase();
        for (let option of categoryFilter.options) {
            if (option.value.toLowerCase() === catUrlLower || option.text.toLowerCase().includes(catUrlLower)) {
                categoryFilter.value = option.value;
                break;
            }
        }
    }

    function renderQuickDays() {
        quickDaysContainer.innerHTML = '';
        const today = new Date();

        for (let i = 0; i < 5; i++) {
            const d = new Date();
            d.setDate(today.getDate() + i);

            const dayName = daysFr[d.getDay()];
            const dayNum = d.getDate();
            const dateStr = d.toISOString().split('T')[0];

            const isActive = dateStr === activeDate;
            const bg = isActive ? 'bg-black text-white' : 'bg-white/80 text-gray-800 border border-black/10 hover:bg-white';
            const sub = isActive ? 'text-gray-300' : 'text-gray-500';

            const btnHTML = `
                <button data-date="${dateStr}" class="quick-day-btn ${bg} rounded-lg p-2 text-center shadow-md flex flex-col items-center justify-center transition cursor-pointer">
                    <span class="text-xs font-semibold ${sub}">${dayName}</span>
                    <span class="text-lg font-black">${dayNum}</span>
                </button>
            `;
            quickDaysContainer.insertAdjacentHTML('beforeend', btnHTML);
        }

        document.querySelectorAll('.quick-day-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const clickedDate = btn.getAttribute('data-date');
                activeDate = (activeDate === clickedDate) ? null : clickedDate;
                calendarBtnLabel.textContent = "Jours";
                renderQuickDays();
                filterCourses();
            });
        });
    }

    function renderMonthGrid() {
        monthGrid.innerHTML = '';
        const today = new Date();
        currentMonthLabel.textContent = `${monthsFr[today.getMonth()]} ${today.getFullYear()}`;

        for (let i = 0; i < 30; i++) {
            const d = new Date();
            d.setDate(today.getDate() + i);

            const dayNum = d.getDate();
            const dateStr = d.toISOString().split('T')[0];
            const isActive = dateStr === activeDate;

            const bgClass = isActive ? 'bg-black text-white font-black' : 'bg-gray-100 text-gray-800 hover:bg-gray-200 font-bold';

            const cell = `
                <button data-date="${dateStr}" class="month-day-btn h-10 rounded-lg text-xs flex items-center justify-center transition ${bgClass}">
                    ${dayNum}
                </button>
            `;
            monthGrid.insertAdjacentHTML('beforeend', cell);
        }

        document.querySelectorAll('.month-day-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                activeDate = btn.getAttribute('data-date');
                const parts = activeDate.split('-');
                calendarBtnLabel.textContent = `${parts[2]}/${parts[1]}`;
                
                renderMonthGrid();
                renderQuickDays();
                filterCourses();
            });
        });
    }

    if (openModalBtn) {
        openModalBtn.onclick = () => {
            renderMonthGrid();
            calendarModal.classList.remove('hidden');
        };
    }

    if (closeModalBtn) closeModalBtn.onclick = () => calendarModal.classList.add('hidden');
    if (confirmModalBtn) confirmModalBtn.onclick = () => calendarModal.classList.add('hidden');

    function filterCourses() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const category = categoryFilter ? categoryFilter.value.toLowerCase().trim() : 'all';
        let count = 0;

        cards.forEach(card => {
            const cardTitle = (card.getAttribute('data-title') || '').toLowerCase().trim();
            const cardCat = (card.getAttribute('data-category') || '').toLowerCase().trim();
            const cardCatId = (card.getAttribute('data-category-id') || '').trim().toLowerCase();
            const cardDate = (card.getAttribute('data-date') || '').trim();

            const matchTitle = !query || cardTitle.includes(query) || cardCat.includes(query);
            
            let matchCat = false;
            if (category === 'all') {
                matchCat = true;
            } else if (category === 'muscu' || category === 'musculation') {
                matchCat = cardCat.includes('muscu') || 
                           cardCat.includes('musculation') || 
                           cardCat.includes('hypertrophie') || 
                           cardCat.includes('force') || 
                           cardTitle.includes('muscu') || 
                           cardTitle.includes('musculation') || 
                           cardTitle.includes('hypertrophie') || 
                           cardTitle.includes('force');
            } else if (category === 'boxe') {
                matchCat = cardCat.includes('boxe') || cardTitle.includes('boxe');
            } else if (category === 'cardio') {
                matchCat = cardCat.includes('cardio') || cardTitle.includes('cardio');
            } else {
                // Recherche souple par ID ou par nom de catégorie / titre
                matchCat = (cardCatId === category) || cardCat.includes(category) || cardTitle.includes(category);
            }

            const matchDate = !activeDate || cardDate === activeDate;

            if (matchTitle && matchCat && matchDate) {
                card.classList.remove('hidden');
                card.classList.add('flex');
                count++;
            } else {
                card.classList.remove('flex');
                card.classList.add('hidden');
            }
        });

        if (noResults) {
            if (count === 0) {
                noResults.classList.remove('hidden');
            } else {
                noResults.classList.add('hidden');
            }
        }
    }

    renderQuickDays();
    filterCourses();
    
    if (searchInput) searchInput.oninput = filterCourses;
    if (categoryFilter) categoryFilter.onchange = filterCourses;
}

document.addEventListener('DOMContentLoaded', initSeancesPage);
document.addEventListener('turbo:load', initSeancesPage);
</script>
{% endblock %}