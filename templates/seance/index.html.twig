{% extends 'base.html.twig' %}

{% block title %}Cours disponibles - FitBooking{% endblock %}

{% block body %}
<div class="bg-[#e2c375] min-h-screen text-black pb-28 pt-4 px-4 max-w-md mx-auto relative">

    {# Titre + Bouton Jours #}
    <div class="flex items-center justify-between mb-4">
        <h1 class="text-2xl font-black tracking-tight text-gray-900">Cours disponibles</h1>
        <button id="open-calendar-modal-btn" class="flex items-center space-x-1.5 bg-black/10 hover:bg-black/20 px-3 py-1.5 rounded-lg text-xs font-black text-gray-900 transition cursor-pointer">
            <svg class="w-4 h-4 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span id="calendar-btn-label">Jours</span>
            <svg class="w-3 h-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
    </div>

    {# Calendrier horizontal (5 jours) #}
    <div id="quick-days-container" class="grid grid-cols-5 gap-2 mb-5"></div>

    {# Recherche + Filtre #}
    <div class="flex items-center space-x-2 mb-6">
        <div class="relative flex-1">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input 
                type="text" 
                id="search-input"
                placeholder="Rechercher un cours...." 
                class="w-full pl-9 pr-3 py-2 bg-white rounded-lg text-xs font-medium text-gray-800 placeholder-gray-500 focus:outline-none shadow-sm"
            >
        </div>
        <div class="relative">
            <select 
                id="category-filter" 
                class="appearance-none bg-white pl-3 pr-7 py-2 rounded-lg text-xs font-bold text-gray-800 focus:outline-none shadow-sm cursor-pointer"
            >
                <option value="all">Toutes</option>
                <option value="cardio">Cardio</option>
                <option value="muscu">Muscu</option>
                <option value="boxe">Boxe</option>
            </select>
            <svg class="w-3 h-3 absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-600 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </div>
    </div>

    {# LISTE DES COURS  #}
    <div id="seances-list" class="space-y-4">
        
        {# CARTE 1 : MUSCU #}
        <div class="seance-card bg-white rounded-xl p-3 shadow-md border border-gray-100 flex flex-col justify-between"
             data-title="hypertrophie" 
             data-category="muscu"
             data-date="today">
            <div>
                <div class="flex items-center justify-between text-[11px] font-extrabold tracking-wider text-gray-500 mb-2">
                    <div class="flex space-x-1.5">
                        <span class="bg-gray-200 px-2 py-0.5 rounded text-gray-700 uppercase">MUSCU</span>
                        <span class="bg-gray-200 px-2 py-0.5 rounded text-gray-700">60 MIN</span>
                    </div>
                    <span class="uppercase text-gray-800">3 PLACES RESTANTES</span>
                </div>

                <div class="flex space-x-3 items-center my-3">
                    <div class="w-20 h-20 bg-gray-200 rounded-lg overflow-hidden flex-shrink-0">
                        <img src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?auto=format&fit=crop&w=300&q=80" alt="Hypertrophie" class="w-full h-full object-cover">
                    </div>
                    <div>
                        <h2 class="course-title text-xl font-black text-gray-900 leading-tight">Hypertrophie</h2>
                        <p class="text-xs font-semibold text-gray-500 mt-1">08:00 H / 09:00 H</p>
                        <p class="text-xs font-bold text-gray-700 mt-0.5">Coach Alexis</p>
                    </div>
                </div>
            </div>

            <hr class="border-gray-200 my-2">

            <div class="flex space-x-2 pt-1">
                <button class="flex-1 bg-black text-white font-black py-2 rounded-lg text-xs tracking-wider uppercase hover:bg-gray-800 transition">
                    REJOINDRE
                </button>
                <button class="w-9 h-9 flex items-center justify-center border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </button>
            </div>
        </div>

        {# CARTE 2 : CARDIO #}
        <div class="seance-card bg-white rounded-xl p-3 shadow-md border border-gray-100 flex flex-col justify-between"
             data-title="cardio hit" 
             data-category="cardio"
             data-date="today">
            <div>
                <div class="flex items-center justify-between text-[11px] font-extrabold tracking-wider text-gray-500 mb-2">
                    <div class="flex space-x-1.5">
                        <span class="bg-gray-200 px-2 py-0.5 rounded text-gray-700 uppercase">CARDIO</span>
                        <span class="bg-gray-200 px-2 py-0.5 rounded text-gray-700">45 MIN</span>
                    </div>
                    <span class="uppercase text-gray-800">12 PLACES RESTANTES</span>
                </div>

                <div class="flex space-x-3 items-center my-3">
                    <div class="w-20 h-20 bg-gray-200 rounded-lg overflow-hidden flex-shrink-0">
                        <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=300&q=80" alt="Cardio HIT" class="w-full h-full object-cover">
                    </div>
                    <div>
                        <h2 class="course-title text-xl font-black text-gray-900 leading-tight">Cardio HIT</h2>
                        <p class="text-xs font-semibold text-gray-500 mt-1">10:30 H / 11:15 H</p>
                        <p class="text-xs font-bold text-gray-700 mt-0.5">Coach Loic</p>
                    </div>
                </div>
            </div>

            <hr class="border-gray-200 my-2">

            <div class="flex space-x-2 pt-1">
                <button class="flex-1 bg-black text-white font-black py-2 rounded-lg text-xs tracking-wider uppercase hover:bg-gray-800 transition">
                    REJOINDRE
                </button>
                <button class="w-9 h-9 flex items-center justify-center border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </button>
            </div>
        </div>

        {# CARTE 3 : BOXE #}
        <div class="seance-card bg-white rounded-xl p-3 shadow-md border border-gray-100 flex flex-col justify-between"
             data-title="boxe anglaise" 
             data-category="boxe"
             data-date="today">
            <div>
                <div class="flex items-center justify-between text-[11px] font-extrabold tracking-wider text-gray-500 mb-2">
                    <div class="flex space-x-1.5">
                        <span class="bg-gray-200 px-2 py-0.5 rounded text-gray-700 uppercase">BOXE</span>
                        <span class="bg-gray-200 px-2 py-0.5 rounded text-gray-700">30 MIN</span>
                    </div>
                    <span class="uppercase text-gray-800">1 PLACES RESTANTES</span>
                </div>

                <div class="flex space-x-3 items-center my-3">
                    <div class="w-20 h-20 bg-gray-200 rounded-lg overflow-hidden flex-shrink-0">
                        <img src="https://images.unsplash.com/photo-1549719386-74dfcbf7dbed?auto=format&fit=crop&w=300&q=80" alt="Boxe Anglaise" class="w-full h-full object-cover">
                    </div>
                    <div>
                        <h2 class="course-title text-xl font-black text-gray-900 leading-tight">Boxe Anglaise</h2>
                        <p class="text-xs font-semibold text-gray-500 mt-1">11:00 H / 11:30 H</p>
                        <p class="text-xs font-bold text-gray-700 mt-0.5">Coach Gaetan</p>
                    </div>
                </div>
            </div>

            <hr class="border-gray-200 my-2">

            <div class="flex space-x-2 pt-1">
                <button class="flex-1 bg-black text-white font-black py-2 rounded-lg text-xs tracking-wider uppercase hover:bg-gray-800 transition">
                    REJOINDRE
                </button>
                <button class="w-9 h-9 flex items-center justify-center border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </button>
            </div>
        </div>

        {# CARTE 4 : RENFORCEMENT #}
        <div class="seance-card bg-white rounded-xl p-3 shadow-md border border-gray-100 flex flex-col justify-between"
             data-title="renforcement" 
             data-category="muscu"
             data-date="today">
            <div>
                <div class="flex items-center justify-between text-[11px] font-extrabold tracking-wider text-gray-500 mb-2">
                    <div class="flex space-x-1.5">
                        <span class="bg-gray-200 px-2 py-0.5 rounded text-gray-700 uppercase">MUSCU</span>
                        <span class="bg-gray-200 px-2 py-0.5 rounded text-gray-700">50 MIN</span>
                    </div>
                    <span class="uppercase text-red-600 font-extrabold">PLEIN</span>
                </div>

                <div class="flex space-x-3 items-center my-3">
                    <div class="w-20 h-20 bg-gray-200 rounded-lg overflow-hidden flex-shrink-0">
                        <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=300&q=80" alt="Renforcement" class="w-full h-full object-cover">
                    </div>
                    <div>
                        <h2 class="course-title text-xl font-black text-gray-900 leading-tight">Renforcement</h2>
                        <p class="text-xs font-semibold text-gray-500 mt-1">12:00 H / 12:50 H</p>
                        <p class="text-xs font-bold text-gray-700 mt-0.5">Coach Jonathan</p>
                    </div>
                </div>
            </div>

            <hr class="border-gray-200 my-2">

            <div class="flex space-x-2 pt-1">
                <button disabled class="flex-1 bg-gray-200 text-gray-500 font-black py-2 rounded-lg text-xs tracking-wider uppercase cursor-not-allowed">
                    PLEIN
                </button>
                <button class="w-9 h-9 flex items-center justify-center border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </button>
            </div>
        </div>

        {# Message si aucun résultat #}
        <div id="no-results" class="hidden text-center py-8 text-gray-800 font-extrabold">
            Aucune séance ne correspond à votre recherche.
        </div>

    </div>
</div>

{# MODALE CALENDRIER #}
<div id="calendar-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center hidden transition-opacity">
    <div class="bg-white w-full max-w-md rounded-t-3xl sm:rounded-2xl p-5 text-gray-900 shadow-2xl">
        <div class="flex items-center justify-between mb-4 border-b pb-3">
            <h3 class="text-lg font-black tracking-tight">Choisir une date</h3>
            <button id="close-calendar-modal" class="w-8 h-8 flex items-center justify-center bg-gray-100 rounded-full text-gray-600 hover:bg-gray-200 font-bold">✕</button>
        </div>

        <div class="text-center font-black text-sm uppercase tracking-wider text-gray-500 mb-3" id="current-month-label"></div>

        <div class="grid grid-cols-7 text-center font-bold text-xs text-gray-400 mb-2">
            <span>Dim</span><span>Lun</span><span>Mar</span><span>Mer</span><span>Jeu</span><span>Ven</span><span>Sam</span>
        </div>

        <div id="month-grid" class="grid grid-cols-7 gap-1.5 text-center mb-4 max-h-64 overflow-y-auto"></div>

        <button id="close-modal-confirm" class="w-full bg-black text-white font-black py-3 rounded-xl text-xs uppercase tracking-wider shadow-lg">
            Valider
        </button>
    </div>
</div>

<script>
function initSeancesPage() {
    const quickDaysContainer = document.getElementById('quick-days-container');
    if (!quickDaysContainer) return; // Sécurité si la page change

    const todayStr = new Date().toISOString().split('T')[0];

    // Attribuer dynamiquement la date du jour aux cartes "today"
    document.querySelectorAll('.seance-card[data-date="today"]').forEach(card => {
        card.setAttribute('data-date', todayStr);
    });

    const calendarModal = document.getElementById('calendar-modal');
    const openModalBtn = document.getElementById('open-calendar-modal-btn');
    const closeModalBtn = document.getElementById('close-calendar-modal');
    const confirmModalBtn = document.getElementById('close-modal-confirm');
    const monthGrid = document.getElementById('month-grid');
    const currentMonthLabel = document.getElementById('current-month-label');
    const calendarBtnLabel = document.getElementById('calendar-btn-label');
    
    const searchInput = document.getElementById('search-input');
    const categoryFilter = document.getElementById('category-filter');
    const cards = document.querySelectorAll('.seance-card');
    const noResults = document.getElementById('no-results');

    const daysFr = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];
    const monthsFr = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
    
    let activeDate = todayStr;

    function renderQuickDays() {
        quickDaysContainer.innerHTML = '';
        const today = new Date();

        for (let i = 0; i < 5; i++) {
            const d = new Date();
            d.setDate(today.getDate() + i);

            const dayName = daysFr[d.getDay()];
            const dayNum = d.getDate();
            const dateStr = d.toISOString().split('T')[0];

            const isActive = dateStr === activeDate;
            const bg = isActive ? 'bg-black text-white' : 'bg-white/80 text-gray-800 border border-black/10';
            const sub = isActive ? 'text-gray-300' : 'text-gray-500';

            const btnHTML = `
                <button data-date="${dateStr}" class="quick-day-btn ${bg} rounded-lg p-2 text-center shadow-md flex flex-col items-center justify-center transition-all cursor-pointer">
                    <span class="text-xs font-semibold ${sub}">${dayName}</span>
                    <span class="text-lg font-black">${dayNum}</span>
                </button>
            `;
            quickDaysContainer.insertAdjacentHTML('beforeend', btnHTML);
        }

        document.querySelectorAll('.quick-day-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                activeDate = btn.getAttribute('data-date');
                calendarBtnLabel.textContent = "Jours";
                renderQuickDays();
                filterCourses();
            });
        });
    }

    function renderMonthGrid() {
        monthGrid.innerHTML = '';
        const today = new Date();
        currentMonthLabel.textContent = `${monthsFr[today.getMonth()]} ${today.getFullYear()}`;

        for (let i = 0; i < 30; i++) {
            const d = new Date();
            d.setDate(today.getDate() + i);

            const dayNum = d.getDate();
            const dateStr = d.toISOString().split('T')[0];
            const isActive = dateStr === activeDate;

            const bgClass = isActive ? 'bg-black text-white font-black' : 'bg-gray-100 text-gray-800 hover:bg-gray-200 font-bold';

            const cell = `
                <button data-date="${dateStr}" class="month-day-btn h-10 rounded-lg text-xs flex items-center justify-center transition ${bgClass}">
                    ${dayNum}
                </button>
            `;
            monthGrid.insertAdjacentHTML('beforeend', cell);
        }

        document.querySelectorAll('.month-day-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                activeDate = btn.getAttribute('data-date');
                const parts = activeDate.split('-');
                calendarBtnLabel.textContent = `${parts[2]}/${parts[1]}`;
                
                renderMonthGrid();
                renderQuickDays();
                filterCourses();
            });
        });
    }

    if (openModalBtn) {
        openModalBtn.onclick = () => {
            renderMonthGrid();
            calendarModal.classList.remove('hidden');
        };
    }

    if (closeModalBtn) closeModalBtn.onclick = () => calendarModal.classList.add('hidden');
    if (confirmModalBtn) confirmModalBtn.onclick = () => calendarModal.classList.add('hidden');

    function filterCourses() {
        const query = searchInput.value.toLowerCase().trim();
        const category = categoryFilter.value.toLowerCase();
        let count = 0;

        cards.forEach(card => {
            const cardTitle = card.getAttribute('data-title').toLowerCase();
            const cardCat = card.getAttribute('data-category').toLowerCase();
            const cardDate = card.getAttribute('data-date');

            const matchTitle = cardTitle.includes(query);
            const matchCat = category === 'all' || cardCat === category;
            const matchDate = !cardDate || cardDate === activeDate;

            if (matchTitle && matchCat && matchDate) {
                card.classList.remove('hidden');
                count++;
            } else {
                card.classList.add('hidden');
            }
        });

        noResults.classList.toggle('hidden', count > 0);
    }

    renderQuickDays();
    filterCourses();
    
    searchInput.oninput = filterCourses;
    categoryFilter.onchange = filterCourses;
}

// Support chargement classique + Symfony Turbo/TurboLinks
document.addEventListener('DOMContentLoaded', initSeancesPage);
document.addEventListener('turbo:load', initSeancesPage);
</script>
{% endblock %}