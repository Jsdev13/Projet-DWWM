{% extends 'base.html.twig' %}

{% set hide_topbar = true %}

{% block title %}Note du Coach - FitBooking{% endblock %}

{% block body %}
<div class="bg-[#121212] min-h-screen text-white pb-28 max-w-md mx-auto relative shadow-2xl flex flex-col justify-between">

    <div>
        {# 1. HEADER PAGE #}
        <div class="flex items-center justify-between px-5 py-5 border-b border-gray-800">
            <a href="javascript:history.back()" class="text-white hover:text-[#E5BA5A] transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
            </a>
            <h1 class="text-lg font-black tracking-widest text-white uppercase">
                NOTE DU COACH
            </h1>
            <div class="w-7 h-7 rounded-full border border-[#E5BA5A] flex items-center justify-center text-[#E5BA5A]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
            </div>
        </div>

        <form method="POST" action="{{ path('app_coach_rate') }}" class="px-6 py-6 space-y-6">

            {# 2. TITRE & ACCROCHE AVEC BORDURE GAUCHE #}
            <div class="space-y-3">
                <h2 class="text-2xl font-black tracking-wider text-[#E5BA5A] uppercase">
                    SOUMETTRE UNE NOTE
                </h2>
                
                <div class="border-l-2 border-[#E5BA5A] pl-4">
                    <p class="text-xs text-gray-400 leading-relaxed font-medium">
                        Vos commentaires sont essentiels à l'excellence.<br>
                        Veuillez fournir une évaluation détaillée des performances de votre entraîneur afin de nous aider à maintenir des standards d'entraînement de haut niveau.
                    </p>
                </div>
            </div>

            {# 3. SÉLECTION DU COACH #}
            <div class="space-y-2 pt-2">
                <label class="block text-[10px] font-black tracking-widest text-gray-400 uppercase">
                    SÉLECTIONNE LE COACH
                </label>
                
                <div class="relative">
                    <select name="coach_name" id="coach_name" class="w-full p-3 rounded-xl border font-bold text-gray-800">
    {% for coach in coachs %}
        <option value="{{ coach }}">{{ coach }}</option>
    {% else %}
        <option value="" disabled selected>Vous n'avez participé à aucun cours pour le moment</option>
    {% endfor %}
</select>
                    <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-white">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </div>
                </div>
            </div>

            {# 4. CARTE ÉVALUATION DES PERFORMANCES (ÉTOILES) #}
            <div class="bg-[#1A1A1A] rounded-xl p-6 text-center space-y-4 border border-gray-800/80 shadow-lg">
                <span class="block text-[10px] font-black tracking-widest text-[#E5BA5A] uppercase">
                    ÉVALUATION DES PERFORMANCES
                </span>

                {# Champ masqué pour envoyer la note dans le POST #}
                <input type="hidden" name="rating" id="rating_value" value="0" required>

                {# Étoiles interactives #}
                <div class="flex justify-center items-center space-x-2 my-3">
                    {% for i in 1..5 %}
                        <button type="button" data-value="{{ i }}" class="star-btn text-gray-700 hover:text-[#E5BA5A] transition transform active:scale-125 focus:outline-none">
                            <svg class="w-9 h-9 fill-current" viewBox="0 0 24 24">
                                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                            </svg>
                        </button>
                    {% endfor %}
                </div>

                <span class="block text-[9px] font-bold tracking-widest text-gray-500 uppercase">
                    APPUYEZ POUR NOTER
                </span>
            </div>

            {# 5. BOUTON SOUMETTRE #}
            <div class="pt-4">
                <button type="submit" class="w-full bg-[#E5BA5A] hover:bg-[#d4aa4f] text-black font-black text-sm uppercase py-4 rounded-lg tracking-wider transition shadow-lg active:scale-98">
                    NOTER
                </button>
            </div>

        </form>
    </div>

</div>

{# Script pour rendre la sélection des étoiles interactive #}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const stars = document.querySelectorAll('.star-btn');
        const ratingInput = document.getElementById('rating_value');

        stars.forEach(star => {
            star.addEventListener('click', () => {
                const value = parseInt(star.getAttribute('data-value'));
                ratingInput.value = value;

                stars.forEach((s, index) => {
                    if (index < value) {
                        s.classList.remove('text-gray-700');
                        s.classList.add('text-[#E5BA5A]');
                    } else {
                        s.classList.remove('text-[#E5BA5A]');
                        s.classList.add('text-gray-700');
                    }
                });
            });
        });
    });
</script>
{% endblock %}