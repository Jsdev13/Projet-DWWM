{% extends 'base.html.twig' %}

{% block title %}Mes séances - FitBooking{% endblock %}

{% block body %}
<div class="bg-[#E5BA5A] flex-1 text-black pb-12 pt-4 px-4 max-w-md mx-auto w-full flex flex-col font-sans">

    {# 1. EN-TÊTE : Titre + Bouton Déconnexion  #}
    <div class="flex items-center justify-between mb-5">
        <h1 class="text-2xl font-black tracking-tight text-gray-900">Mes séances</h1>

        <a 
            href="{{ path('app_logout') }}" 
            class="inline-flex items-center gap-1.5 bg-red-600/10 hover:bg-red-600/20 text-red-600 border border-red-600/30 px-3 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider transition shadow-sm"
            title="Se déconnecter"
        >
            <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            <span>Déconnexion</span>
        </a>
    </div>

    {# 2. Toast Flottant #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div id="toast-flash" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 flex items-center w-[90%] max-w-md p-3.5 text-white bg-black/90 backdrop-blur-md rounded-2xl shadow-2xl border border-white/10 transition-all duration-300 transform translate-y-0 opacity-100">
                <div class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 rounded-xl {% if label == 'success' %}bg-emerald-500/20 text-emerald-400{% else %}bg-amber-500/20 text-amber-400{% endif %}">
                    {% if label == 'success' %}
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    {% else %}
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    {% endif %}
                </div>
                <div class="ml-3 text-xs font-bold leading-tight flex-1">{{ message }}</div>
                <button type="button" id="close-toast-btn" class="ml-auto text-gray-400 hover:text-white p-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        {% endfor %}
    {% endfor %}

    {# 3. Card Résumé EN COURS #}
    <div class="bg-[#e6c87c] rounded-2xl p-4 shadow-md border border-black/10 flex items-center space-x-4 mb-5">
        <div class="w-12 h-12 bg-black rounded-xl flex items-center justify-center flex-shrink-0 shadow">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
        </div>
        <div>
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-gray-600 block">EN COURS</span>
            <span class="text-xl font-black text-gray-900">{{ total_seances|default(reservations|length) }} Seance{{ (total_seances|default(reservations|length)) > 1 ? 's' : '' }}</span>
        </div>
    </div>

    {# 4. Barre de Recherche + Filtre par Catégorie #}
    <div class="flex items-center space-x-2 mb-6">
        <div class="relative flex-1">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input 
                type="text" 
                id="search-input"
                placeholder="Rechercher un cours..." 
                class="w-full pl-9 pr-3 py-2 bg-white rounded-lg text-xs font-medium text-gray-800 placeholder-gray-400 focus:outline-none shadow-sm"
            >
        </div>
        <div class="relative">
            <select 
                id="category-filter" 
                class="appearance-none bg-white pl-3 pr-7 py-2 rounded-lg text-xs font-bold text-gray-800 focus:outline-none shadow-sm cursor-pointer"
            >
                <option value="all">Toutes</option>
                <option value="cardio">Cardio</option>
                <option value="muscu">Muscu</option>
                <option value="boxe">Boxe</option>
            </select>
            <svg class="w-3.5 h-3.5 absolute right-2 top-1/2 -translate-y-1/2 text-gray-800 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
            </svg>
        </div>
    </div>

    {# 5. Titre de la liste #}
    <h2 class="text-[11px] font-black uppercase tracking-wider text-gray-700 mb-3">MES SEANCES</h2>

    {# 6. Liste dynamique issue de la BDD #}
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden divide-y divide-gray-200" id="seances-container">
        {% for reservation in reservations %}
            {% set seance = reservation.seance %}
            {% set catName = seance.categorie ? (seance.categorie.nom is defined ? seance.categorie.nom : seance.categorie) : '' %}
            
            <div class="seance-item p-3.5 flex items-center justify-between transition hover:bg-gray-50"
                 data-title="{{ seance.name|lower }}" 
                 data-category="{{ catName|lower }}">
                
                <div class="flex items-center space-x-3.5">
                    <div class="w-12 h-12 bg-[#232323] rounded-lg flex items-center justify-center flex-shrink-0 text-white">
                        {% if 'muscu' in seance.name|lower or 'muscu' in catName|lower %}
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6h2m14 0h2M5 6v12m14-12v12M9 6h6v12H9z"/></svg>
                        {% elseif 'boxe' in seance.name|lower or 'boxe' in catName|lower %}
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        {% else %}
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                        {% endif %}
                    </div>

                    <div>
                        <h3 class="text-sm font-black text-gray-900 leading-tight">{{ seance.name }}</h3>
                        <p class="text-xs font-semibold text-gray-500 mt-0.5">
                            {{ reservation.dateCreate ? reservation.dateCreate|date('d/m/Y') : '' }} 
                            {% if seance.startTime and seance.endTime %}
                                • {{ seance.startTime|date('H:i') }} - {{ seance.endTime|date('H:i') }}
                            {% endif %}
                        </p>
                    </div>
                </div>

                {# Formulaire d'annulation #}
                <form id="cancel-form-{{ reservation.id }}" action="{{ path('app_profile_annuler_seance', {'id': reservation.id}) }}" method="POST">
                    <button type="button" 
                            data-reservation-id="{{ reservation.id }}" 
                            data-seance-title="{{ seance.name|e('html_attr') }}"
                            class="open-modal-btn text-red-600 hover:text-red-700 p-1 transition cursor-pointer" 
                            title="Annuler la réservation">
                        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                            <path d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"/>
                        </svg>
                    </button>
                </form>
            </div>
        {% else %}
            <div class="p-6 text-center text-xs font-bold text-gray-500">
                Vous n'avez aucune séance réservée pour le moment.
            </div>
        {% endfor %}
    </div>

    <div id="no-results" class="hidden text-center py-8 text-xs font-bold text-gray-700">
        Aucune séance ne correspond à votre recherche.
    </div>
</div>

{# Modale de confirmation #}
<div id="cancel-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-200">
    <div class="bg-white rounded-2xl max-w-xs w-full p-5 text-center shadow-2xl transform scale-95 transition-transform duration-200" id="cancel-modal-card">
        <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <h3 class="text-base font-black text-gray-900 mb-1">Annuler la réservation ?</h3>
        <p class="text-xs text-gray-500 mb-5">Voulez-vous vraiment vous désinscrire de la séance <strong id="modal-seance-title" class="text-gray-800"></strong> ?</p>
        
        <div class="flex space-x-2">
            <button type="button" id="close-modal-btn" class="flex-1 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold rounded-xl transition">
                Garder
            </button>
            <button type="button" id="confirm-cancel-btn" class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-xl transition shadow-md">
                Oui, annuler
            </button>
        </div>
    </div>
</div>

<script>
(() => {
    let currentReservationId = null;

    function openModal(id, title) {
        currentReservationId = id;
        const titleEl = document.getElementById('modal-seance-title');
        if (titleEl) titleEl.innerText = title;

        const modal = document.getElementById('cancel-modal');
        const card = document.getElementById('cancel-modal-card');

        if (modal && card) {
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                card.classList.remove('scale-95');
                card.classList.add('scale-100');
            }, 10);
        }
    }

    function closeModal() {
        const modal = document.getElementById('cancel-modal');
        const card = document.getElementById('cancel-modal-card');

        if (modal && card) {
            modal.classList.add('opacity-0');
            card.classList.remove('scale-100');
            card.classList.add('scale-95');

            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }
    }

    function closeToast() {
        const toast = document.getElementById('toast-flash');
        if (toast) {
            toast.classList.add('-translate-y-5', 'opacity-0');
            setTimeout(() => toast.remove(), 300);
        }
    }

    function initProfileEvents() {
        const toastTimeout = setTimeout(closeToast, 3000);

        const closeToastBtn = document.getElementById('close-toast-btn');
        if (closeToastBtn) {
            closeToastBtn.onclick = () => {
                clearTimeout(toastTimeout);
                closeToast();
            };
        }

        document.querySelectorAll('.open-modal-btn').forEach(btn => {
            btn.onclick = (e) => {
                e.preventDefault();
                const resId = btn.getAttribute('data-reservation-id');
                const title = btn.getAttribute('data-seance-title');
                openModal(resId, title);
            };
        });

        const closeModalBtn = document.getElementById('close-modal-btn');
        if (closeModalBtn) closeModalBtn.onclick = closeModal;

        const confirmBtn = document.getElementById('confirm-cancel-btn');
        if (confirmBtn) {
            confirmBtn.onclick = () => {
                if (currentReservationId) {
                    const form = document.getElementById(`cancel-form-${currentReservationId}`);
                    if (form) form.submit();
                }
            };
        }

        const searchInput = document.getElementById('search-input');
        const categoryFilter = document.getElementById('category-filter');
        const items = document.querySelectorAll('.seance-item');
        const noResults = document.getElementById('no-results');

        if (searchInput && categoryFilter) {
            const filterSeances = () => {
                const query = searchInput.value.toLowerCase().trim();
                const category = categoryFilter.value.toLowerCase();
                let visibleCount = 0;

                items.forEach(item => {
                    const title = item.getAttribute('data-title') || '';
                    const cat = item.getAttribute('data-category') || '';

                    const matchTitle = title.includes(query);
                    const matchCat = (category === 'all' || cat.includes(category) || title.includes(category));

                    if (matchTitle && matchCat) {
                        item.classList.remove('hidden');
                        visibleCount++;
                    } else {
                        item.classList.add('hidden');
                    }
                });

                if (noResults) {
                    noResults.classList.toggle('hidden', visibleCount > 0);
                }
            };

            searchInput.oninput = filterSeances;
            categoryFilter.onchange = filterSeances;
        }
    }

    document.addEventListener('DOMContentLoaded', initProfileEvents);
    document.addEventListener('turbo:load', initProfileEvents);
})();
</script>
{% endblock %}