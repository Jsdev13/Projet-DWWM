{% extends 'base.html.twig' %}

{% set nom = coach.prenom is defined and coach.prenom ? coach.prenom : (coach.nom is defined ? coach.nom : 'COACH') %}
{% set specialite = coach.specialite is defined ? coach.specialite : 'COACH SPORTIF' %}
{% set desc = coach.description is defined ? coach.description : '' %}
{% set photo = coach.photo is defined ? coach.photo : 'https://images.unsplash.com/photo-1567013127542-490d757e51fc?auto=format&fit=crop&q=80&w=800' %}
{% set education = coach.education is defined ? coach.education : [
    'Formation en préparation physique et coaching sportif.',
    'Accompagnement personnalisé et suivi de performance.'
] %}

{% set certifications = coach.certifications is defined ? coach.certifications : {
    'Diplôme d\'État': 'Éducateur sportif certifié.'
} %}

{# --- CALCUL DYNAMIQUE DE LA NOTE MOYENNE ET DES AVIS --- #}
{% set avgRating = coach.averageRating is defined ? coach.averageRating : 0.0 %}
{% set totalAvis = coach.notesReceived is defined ? coach.notesReceived|length : 0 %}

{% block title %}Coach MR. {{ nom }} - FitBooking{% endblock %}

{% block body %}
{# Conteneur principal avec le fond bordeaux/marron #}
<div class="bg-[#532E32] min-h-screen text-white pb-28 max-w-md md:max-w-xl mx-auto relative shadow-2xl transition-all duration-300">

    {# 1. PHOTO DU COACH #}
    <div class="relative w-full h-[420px] bg-black">
        <img src="{{ photo }}" alt="Coach MR. {{ nom }}" class="w-full h-full object-cover object-top opacity-90">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#532E32]"></div>
    </div>

    {# 2. CONTENU DU PROFIL #}
    <div class="px-6 -mt-6 relative z-10 space-y-6">

        {# En-tête : Nom + Spécialité #}
        <div>
            <h1 class="text-2xl md:text-3xl font-black tracking-wide text-[#E5BA5A] uppercase">
                MR. {{ nom }}
            </h1>
            <p class="text-xs font-bold tracking-widest text-gray-300 uppercase mt-1">
                {{ specialite }}
            </p>
        </div>

        {# Ligne de séparation + Titre À PROPOS #}
        <div class="flex items-center space-x-4 my-4">
            <div class="flex-1 h-[1px] bg-white/30"></div>
            <span class="text-xs font-black uppercase tracking-widest text-gray-200">À PROPOS</span>
            <div class="flex-1 h-[1px] bg-white/30"></div>
        </div>

        {# Bio / Description #}
        <p class="text-xs md:text-sm font-medium italic text-gray-200 leading-relaxed">
            {{ desc }}
        </p>

        {# 3. CARTE EDUCATION #}
        <div class="bg-[#EAEAEA] text-black rounded-2xl p-5 shadow-lg space-y-3">
            <h3 class="text-base font-black text-black">Education :</h3>
            
            <div class="space-y-2.5 text-xs md:text-sm font-semibold text-gray-800">
                {% for item in education %}
                    <div class="flex items-start space-x-3">
                        <div class="w-5 h-5 rounded-full border border-black flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg class="w-3 h-3 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>
                        <p>{{ item }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# 4. SECTION CERTIFICATIONS #}
        <div class="space-y-3 pt-2">
            <h3 class="text-base font-black text-white">Certifications :</h3>
            
            <div class="space-y-3 text-xs md:text-sm font-medium text-gray-200 leading-relaxed">
                {% for label, detail in certifications %}
                    <p>
                        <strong class="italic text-white">{{ label }} :</strong> {{ detail }}
                    </p>
                {% endfor %}
            </div>
        </div>

        {# 5. SECTION NOTES ET AVIS DYNAMIQUES #}
        <div class="pt-4 space-y-2">
            <span class="text-[10px] font-black tracking-widest text-gray-300 uppercase">NOTES</span>
            
            <div class="flex items-center space-x-3">
                <!-- Chiffre de la Moyenne (ex: 4.5) -->
                <span class="text-3xl font-black text-white tracking-tight">
                    {{ avgRating > 0 ? (avgRating|number_format(1, '.', '')) : '0.0' }}
                </span>

                <!-- Étoiles dynamiques selon la moyenne -->
                <div class="flex space-x-1 text-[#E5BA5A]">
                    {% set avgInt = avgRating|round(0, 'floor') %}
                    {% for i in 1..5 %}
                        <svg class="w-5 h-5 {{ i <= avgInt ? 'fill-current' : 'text-gray-600/60 fill-current' }}" viewBox="0 0 24 24">
                            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                        </svg>
                    {% endfor %}
                </div>
            </div>

            <!-- Texte du nombre total d'avis -->
            <p class="text-xs font-semibold text-gray-300">
                {% if totalAvis > 0 %}
                    Basé sur {{ totalAvis }} avis client{% if totalAvis > 1 %}s{% endif %}
                {% else %}
                    Aucun avis pour le moment
                {% endif %}
            </p>
        </div>

    </div>

</div>
{% endblock %}