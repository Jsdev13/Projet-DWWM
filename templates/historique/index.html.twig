{% extends 'base.html.twig' %}

{% block title %}Mon historique - FitBooking{% endblock %}

{% block body %}
<div class="bg-[#E5BA5A] flex-1 text-black pb-16 pt-4 px-4 max-w-md mx-auto w-full flex flex-col font-sans">

    <h1 class="text-2xl font-black tracking-tight text-gray-900 mb-4">Mon historique</h1>

    <div class="bg-[#e6c87c] rounded-2xl p-4 shadow-sm border border-black/10 flex items-center space-x-4 mb-5">
        <div class="w-12 h-12 bg-[#1c1c1e] rounded-xl flex items-center justify-center flex-shrink-0 shadow">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div>
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-gray-700 block">HISTORIQUE</span>
            <span class="text-xl font-black text-gray-900">{{ total_historique|default(historiques|length) }} Séance{{ (total_historique|default(historiques|length)) > 1 ? 's' : '' }} au total</span>
        </div>
    </div>

    <div class="flex items-center space-x-2 mb-6">
        <div class="relative flex-1">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input
                type="text"
                id="search-input"
                placeholder="Rechercher un cours..."
                class="w-full pl-9 pr-3 py-2 bg-white rounded-lg text-xs font-medium text-gray-800 placeholder-gray-400 focus:outline-none shadow-sm border border-black/5"
            >
        </div>
        <div class="relative">
            <select
                id="category-filter"
                class="appearance-none bg-white pl-3 pr-8 py-2 rounded-lg text-xs font-bold text-gray-800 focus:outline-none shadow-sm border border-black/5 cursor-pointer"
            >
                <option value="all">Toutes les catégories</option>
                <option value="cardio">Cardio</option>
                <option value="muscu">Musculation</option>
                <option value="boxe">Boxe</option>
            </select>
            <svg class="w-3.5 h-3.5 absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-800 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
            </svg>
        </div>
    </div>

    <h2 class="text-[11px] font-black uppercase tracking-wider text-gray-700 mb-3">RÉCEMMENT TERMINÉES</h2>

    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden divide-y divide-gray-100 mb-6" id="historique-container">
        {% for item in historiques %}
            {% set seance = item.seance %}
            {% set catName = seance.categorie ? seance.categorie.name : (
        ('muscu' in seance.name|lower or 'hypertrophie' in seance.name|lower) ? 'musculation' :
        (('cardio' in seance.name|lower or 'sprint' in seance.name|lower or 'endurance' in seance.name|lower) ? 'cardio' :
        (('boxe' in seance.name|lower) ? 'boxe' : ''))
         )
        %}

            <div class="historique-item p-3.5 flex items-center justify-between transition hover:bg-gray-50"
                 data-title="{{ seance.name|lower }}"
                 data-category="{{ catName|lower }}">

                <div class="flex items-center space-x-3.5">
                    <div class="w-12 h-12 bg-[#232323] rounded-lg flex items-center justify-center flex-shrink-0 text-white">
                        {% if 'muscu' in seance.name|lower or 'hypertrophie' in seance.name|lower or 'muscu' in catName|lower %}
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6h2m14 0h2M5 6v12m14-12v12M9 6h6v12H9z"/></svg>
                        {% elseif 'cardio' in seance.name|lower or 'sprint' in seance.name|lower or 'cardio' in catName|lower %}
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        {% else %}
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                        {% endif %}
                    </div>
                    <div>
                        <h3 class="text-sm font-black text-gray-900 leading-tight">{{ seance.name }}</h3>
                        <p class="text-xs font-semibold text-gray-400 mt-0.5">
                            {{ seance.date ? seance.date|date('d M Y') : '' }} • {{ seance.dureeMinutes|default(45) }} min
                        </p>
                    </div>
                </div>
                <div class="flex-shrink-0 text-emerald-500">
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                </div>
            </div>
        {% else %}
            <div class="p-6 text-center text-sm font-semibold text-gray-400">
                Vous n'avez pas encore de séance terminée dans votre historique.
            </div>
        {% endfor %}
    </div>

    <button
        type="button"
        id="load-more-btn"
        class="w-full max-w-[200px] mx-auto bg-white hover:bg-gray-50 text-gray-900 font-extrabold text-xs py-3 px-4 rounded-xl shadow-md border border-black/10 flex items-center justify-center space-x-2 transition active:scale-95"
    >
        <span>Charger plus</span>
        <svg class="w-4 h-4 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
        </svg>
    </button>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('search-input');
    const categoryFilter = document.getElementById('category-filter');
    const items = document.querySelectorAll('.historique-item');

    function filterItems() {
        const searchTerm = (searchInput.value || '').toLowerCase();
        const category = categoryFilter.value;

        items.forEach(function (item) {
            const title = item.dataset.title || '';
            const itemCategory = item.dataset.category || '';
            const matchesSearch = title.includes(searchTerm);
            const matchesCategory = category === 'all' || itemCategory.includes(category);
            item.style.display = (matchesSearch && matchesCategory) ? 'flex' : 'none';
        });
    }

    if (searchInput && categoryFilter) {
        searchInput.addEventListener('input', filterItems);
        categoryFilter.addEventListener('change', filterItems);
    }
});
</script>
{% endblock %}