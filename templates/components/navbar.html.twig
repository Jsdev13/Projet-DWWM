{# 1. TOP HEADER #}
<header class="sticky top-0 z-40 bg-[#1c1c1e]/95 backdrop-blur-sm border-b border-gray-800/80 px-4 py-3.5 flex items-center justify-between">
    <button 
        type="button"
        onclick="document.getElementById('mobile-drawer').classList.toggle('hidden')"
        aria-label="Ouvrir le menu"
        class="p-1.5 rounded-lg text-white hover:bg-gray-800/60 transition-colors focus:outline-none"
    >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
    </button>

    <a href="{{ path('app_home') }}" class="flex items-center">
        <span class="text-2xl font-black italic tracking-wider text-white uppercase">FitBooking</span>
    </a>

    <a 
        href="{{ app.user ? path('app_profile') : path('app_login') }}"
        aria-label="Mon profil"
        class="p-1.5 rounded-full hover:bg-gray-800/60 transition-colors flex items-center justify-center text-[#dfbe6b]"
    >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
    </a>
</header>

{# 2. MOBILE DRAWER MENU #}
<div id="mobile-drawer" class="hidden fixed inset-0 top-[57px] z-30 bg-[#141415]/95 backdrop-blur-md border-b border-gray-800 flex flex-col p-6 space-y-6">
    <nav class="flex flex-col space-y-4">
        <a href="{{ path('app_home') }}" class="flex items-center space-x-3 text-lg font-bold text-[#dfbe6b] py-2 border-b border-gray-800/50">
            <span>ACCUEIL</span>
        </a>
        <a href="#" class="flex items-center space-x-3 text-lg font-bold text-gray-200 hover:text-[#dfbe6b] py-2 border-b border-gray-800/50 transition-colors">
            <span>SÉANCES & ACTIVITÉS</span>
        </a>
        <a href="#" class="flex items-center space-x-3 text-lg font-bold text-gray-200 hover:text-[#dfbe6b] py-2 border-b border-gray-800/50 transition-colors">
            <span>NOS COACHES</span>
        </a>
    </nav>

    <div class="pt-4">
        {% if app.user %}
            <a href="{{ path('app_logout') }}" class="block w-full text-center bg-gray-800 text-white font-extrabold uppercase py-3 rounded-lg text-sm">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="block w-full text-center bg-[#dfbe6b] text-black font-extrabold uppercase py-3 rounded-lg text-sm">Connexion / Inscription</a>
        {% endif %}
    </div>
</div>

{# 3. BOTTOM NAVIGATION BAR #}
{% set current_route = app.request.attributes.get('_route') %}

<nav class="fixed bottom-0 left-0 right-0 bg-[#141415] border-t border-gray-800/90 py-2 px-6 flex justify-around items-center z-50 max-w-md mx-auto">
    <a href="{{ path('app_home') }}" class="flex flex-col items-center py-1 {{ current_route == 'app_home' ? 'text-[#dfbe6b]' : 'text-gray-400' }}">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 00-1 1m-6 0h6"/></svg>
        <span class="text-[10px] font-black uppercase mt-1">HOME</span>
    </a>
    <a href="#" class="flex flex-col items-center py-1 text-gray-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        <span class="text-[10px] font-black uppercase mt-1">COACH</span>
    </a>
    <a href="{{ app.user ? path('app_profile') : path('app_login') }}" class="flex flex-col items-center py-1 text-gray-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span class="text-[10px] font-black uppercase mt-1">MEMBRE</span>
    </a>
</nav>