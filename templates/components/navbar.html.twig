{% set current_route = app.request.attributes.get('_route') %}

{# BOTTOM NAVIGATION BAR (Uniquement visible sur Mobile) #}
{# Le header et le menu burger sont gérés par components/topbar.html.twig #}
<nav class="md:hidden fixed bottom-0 left-0 right-0 bg-[#1c1c1e] border-t border-gray-800 py-3 px-6 flex items-center justify-around z-30">
    <a href="{{ path('app_home') }}" class="flex flex-col items-center {{ current_route == 'app_home' ? 'text-[#dfbe6b]' : 'text-gray-400 hover:text-white' }}">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span class="text-[10px] uppercase mt-1 font-bold">HOME</span>
    </a>

    <a href="{{ path('app_historique') }}" class="flex flex-col items-center {{ current_route == 'app_historique' ? 'text-[#dfbe6b]' : 'text-gray-400 hover:text-white' }}">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="text-[10px] uppercase mt-1 font-bold">HISTORIQUE</span>
    </a>

    <a href="{{ path('app_profile') }}" class="flex flex-col items-center {{ current_route == 'app_profile' ? 'text-[#dfbe6b]' : 'text-gray-400 hover:text-white' }}">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        <span class="text-[10px] uppercase mt-1 font-bold">MEMBRE</span>
    </a>
</nav>
