{% set current_route = app.request.attributes.get('_route') %}

{# 1. TOP HEADER #}
<header class="sticky top-0 z-40 backdrop-blur-sm bg-[#141415]/90 border-b border-gray-800/80 px-4 py-3.5 flex items-center justify-between">
    <button 
        type="button"
        onclick="document.getElementById('mobile-drawer').classList.toggle('hidden')"
        aria-label="Ouvrir le menu"
        class="p-1.5 rounded-lg text-white hover:bg-gray-800/60 transition-colors focus:outline-none"
    >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
    </button>

    <a href="{{ path('app_home') }}" class="flex items-center">
        <span class="text-2xl font-black italic tracking-wider text-white uppercase">FitBooking</span>
    </a>

    {# Bouton Profil / Connexion Rapide en haut à droite #}
    {% if app.user %}
        <a 
            href="{{ path('app_profile') }}"
            aria-label="Mon profil"
            class="p-1.5 rounded-full hover:bg-gray-800/60 transition-colors flex items-center justify-center text-[#dfbe6b]"
            title="{{ app.user.userIdentifier }}"
        >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
        </a>
    {% else %}
        <a 
            href="{{ path('app_login') }}"
            class="text-xs font-bold bg-[#dfbe6b] text-black px-3 py-1.5 rounded-lg transition hover:bg-[#c9aa5d]"
        >
            Connexion
        </a>
    {% endif %}
</header>

{# 2. MOBILE DRAWER MENU #}
<div id="mobile-drawer" class="hidden fixed inset-0 top-[57px] z-30 bg-[#141415]/95 backdrop-blur-md border-b border-gray-800 flex flex-col p-6 space-y-6">
    <nav class="flex flex-col space-y-4">
        {# TOUS : Accueil #}
        <a href="{{ path('app_home') }}" class="flex items-center space-x-3 text-lg font-bold {{ current_route == 'app_home' ? 'text-[#dfbe6b]' : 'text-gray-200' }} py-2 border-b border-gray-800/50">
            <span>ACCUEIL</span>
        </a>

        {# MEMBRE : Lien vers Historique / Mes séances #}
        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('app_profile') }}" class="flex items-center space-x-3 text-lg font-bold {{ current_route in ['app_profile', 'app_historique'] ? 'text-[#dfbe6b]' : 'text-gray-200' }} py-2 border-b border-gray-800/50">
                <span>MON HISTORIQUE</span>
            </a>
        {% endif %}

        {# TOUS : Nos Coaches (Déplacé ici pour libérer de la place en bas) #}
        <a href="#" class="flex items-center space-x-3 text-lg font-bold text-gray-200 hover:text-[#dfbe6b] py-2 border-b border-gray-800/50 transition-colors">
            <span>NOS COACHES</span>
        </a>

        {# ADMIN : Espace Administration #}
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_admin') }}" class="flex items-center space-x-3 text-lg font-bold text-red-500 hover:text-red-400 py-2 border-b border-gray-800/50 transition-colors">
                <span>ESPACE ADMIN</span>
            </a>
        {% endif %}
    </nav>

    {# BOUTON D'ACTION SELON STATUT #}
    <div class="pt-4">
        {% if app.user %}
            <a href="{{ path('app_logout') }}" class="block w-full text-center bg-red-600/20 text-red-500 border border-red-600/30 font-extrabold uppercase py-3 rounded-lg text-sm hover:bg-red-600/30 transition">
                Déconnexion ({{ app.user.userIdentifier }})
            </a>
        {% else %}
            <div class="flex flex-col space-y-2">
                <a href="{{ path('app_login') }}" class="block w-full text-center bg-[#dfbe6b] text-black font-extrabold uppercase py-3 rounded-lg text-sm hover:bg-[#c9aa5d] transition">
                    Se Connecter
                </a>
                <a href="{{ path('app_register') }}" class="block w-full text-center bg-gray-800 text-white font-bold uppercase py-3 rounded-lg text-sm hover:bg-gray-700 transition">
                    Créer un compte
                </a>
            </div>
        {% endif %}
    </div>
</div>

{# 3. BOTTOM NAVIGATION BAR #}
<nav class="fixed bottom-0 left-0 right-0 bg-[#141415] border-t border-gray-800/90 py-2 px-6 flex justify-around items-center z-50 max-w-md mx-auto">
    
    {# 1. ACCUEIL #}
    <a href="{{ path('app_home') }}" class="flex flex-col items-center py-1 {{ current_route == 'app_home' ? 'text-[#dfbe6b]' : 'text-gray-400 hover:text-gray-200' }}">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 00-1 1m-6 0h6"/></svg>
        <span class="text-[10px] font-black uppercase mt-1">HOME</span>
    </a>

    {# 2. HISTORIQUE (Identique au visuel de ta maquette) #}
    <a href="{{ app.user ? path('app_profile') : path('app_login') }}" class="flex flex-col items-center py-1 relative {{ current_route in ['app_historique', 'app_seances'] ? 'text-[#dfbe6b]' : 'text-gray-400 hover:text-gray-200' }}">
        {# Barre dorée au-dessus de l'icône si l'onglet est actif #}
        {% if current_route in ['app_historique', 'app_seances'] %}
            <span class="absolute -top-2 w-8 h-[2px] bg-[#dfbe6b] rounded-full"></span>
        {% endif %}
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-[10px] font-black uppercase mt-1">HISTORIQUE</span>
    </a>

    {# 3. ESPACE MEMBRE / CONNEXION #}
    <a href="{{ app.user ? path('app_profile') : path('app_login') }}" class="flex flex-col items-center py-1 {{ current_route in ['app_profile', 'app_login'] ? 'text-[#dfbe6b]' : 'text-gray-400 hover:text-gray-200' }}">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        <span class="text-[10px] font-black uppercase mt-1">
            {% if app.user %}MEMBRE{% else %}CONNEXION{% endif %}
        </span>
    </a>

    {# 4. ESPACE ADMIN (S'affiche SEULEMENT pour les Admins) #}
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_admin') }}" class="flex flex-col items-center py-1 {{ current_route starts with 'app_admin' ? 'text-red-500' : 'text-red-400/70 hover:text-red-400' }}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>
            <span class="text-[10px] font-black uppercase mt-1">ADMIN</span>
        </a>
    {% endif %}

</nav>