{# BARRE SUPERIEURE (Header) #}
<header class="bg-[#1c1c1e] text-white px-4 md:px-8 py-3.5 border-b border-gray-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto grid grid-cols-3 items-center">
        
        {# GAUCHE : BOUTON BURGER (Mobile) #}
        <div class="flex items-center justify-start">
            <button id="burger-btn" type="button" class="md:hidden p-1.5 text-[#dfbe6b] hover:text-white focus:outline-none cursor-pointer">
                <svg class="w-7 h-7 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
        </div>

        {# CENTRE : LOGO FITBOOKING #}
        <div class="flex justify-center text-center">
            <a href="{{ path('app_home') }}" class="font-black italic text-xl md:text-2xl tracking-wider text-white whitespace-nowrap">
                FITBOOKING
            </a>
        </div>

        {# DROITE : MENU DESKTOP + ICONE PROFIL MOBILE #}
        <div class="flex items-center justify-end space-x-6">
            {# Menu Desktop #}
            <nav class="hidden md:flex items-center space-x-6">
                <a href="{{ path('app_services') }}" class="text-xs font-bold uppercase tracking-widest text-gray-300 hover:text-[#dfbe6b] transition">
                    SERVICE
                </a>
                <a href="{{ path('app_seance_index') }}" class="text-xs font-bold uppercase tracking-widest text-gray-300 hover:text-[#dfbe6b] transition">
                    SEANCE
                </a>
                <a href="{{ path('app_coach_index') }}" class="text-xs font-bold uppercase tracking-widest text-gray-300 hover:text-[#dfbe6b] transition">
                    COACH
                </a>
                <a href="{{ path('app_coach_rate') }}" class="text-xs font-bold uppercase tracking-widest text-gray-300 hover:text-[#dfbe6b] transition">
                    NOTE COACH
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard') }}" class="text-xs font-bold uppercase tracking-widest text-red-400 hover:text-red-300 transition">
                        ADMIN
                    </a>
                {% endif %}
            </nav>

            {# Boutons Connexion / Déconnexion (PC uniquement) #}
            <div class="hidden md:flex items-center">
                {% if app.user %}
                    <a href="{{ path('app_logout') }}" class="bg-red-600/20 text-red-400 border border-red-500/30 font-bold text-xs px-4 py-2 rounded-lg uppercase tracking-wider hover:bg-red-600 hover:text-white transition">
                        Déconnexion
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="bg-[#dfbe6b] text-black font-extrabold text-xs px-5 py-2 rounded-lg uppercase tracking-wider hover:bg-white transition">
                        Connexion
                    </a>
                {% endif %}
            </div>

            {# ICONE PROFIL DORÉE (Mobile uniquement) #}
            <a href="{{ app.user ? path('app_profile') : path('app_login') }}" class="md:hidden text-[#dfbe6b] hover:text-white transition-colors p-1" title="Mon Profil">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </a>
        </div>
        
    </div>
</header>

{# TIROIR BURGER (Mobile uniquement) #}
<div id="mobile-drawer" class="hidden md:hidden fixed inset-0 bg-[#141415] z-50 flex flex-col items-center justify-start pt-12 px-6 space-y-6">
    <button id="close-drawer-btn" type="button" class="absolute top-5 right-5 text-white hover:text-[#dfbe6b] cursor-pointer">
        <svg class="w-7 h-7 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>

    <div class="flex flex-col items-center mb-2">
        <div class="w-16 h-16 rounded-full bg-[#dfbe6b] flex items-center justify-center text-black mb-2">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
        </div>
        {% if app.user %}
            <span class="text-white font-bold text-sm">{{ app.user.userIdentifier }}</span>
        {% else %}
            <a href="{{ path('app_login') }}" class="text-[#dfbe6b] font-bold text-sm hover:underline">Login</a>
        {% endif %}
    </div>

    <div class="w-full max-w-xs space-y-3">
        <a href="{{ path('app_services') }}" class="block w-full text-center py-2.5 border border-[#dfbe6b] text-[#dfbe6b] font-black uppercase text-xs tracking-widest rounded-lg hover:bg-[#dfbe6b] hover:text-black transition">
            SERVICE
        </a>
        <a href="{{ path('app_seance_index') }}" class="block w-full text-center py-2.5 border border-[#dfbe6b] text-[#dfbe6b] font-black uppercase text-xs tracking-widest rounded-lg hover:bg-[#dfbe6b] hover:text-black transition">
            SEANCE
        </a>
        <a href="{{ path('app_coach_index') }}" class="block w-full text-center py-2.5 border border-[#dfbe6b] text-[#dfbe6b] font-black uppercase text-xs tracking-widest rounded-lg hover:bg-[#dfbe6b] hover:text-black transition">
            COACH
        </a>
        <a href="{{ path('app_coach_rate') }}" class="block w-full text-center py-2.5 border border-[#dfbe6b] text-[#dfbe6b] font-black uppercase text-xs tracking-widest rounded-lg hover:bg-[#dfbe6b] hover:text-black transition">
            NOTE COACH
        </a>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_dashboard') }}" class="block w-full text-center py-2.5 border border-[#dfbe6b] text-[#dfbe6b] font-black uppercase text-xs tracking-widest rounded-lg hover:bg-[#dfbe6b] hover:text-black transition">
                ADMIN
            </a>
        {% endif %}
    </div>
</div>