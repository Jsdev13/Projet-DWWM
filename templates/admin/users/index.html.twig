{% extends 'base.html.twig' %}

{% block title %}Utilisateurs inscrits - FitBooking{% endblock %}

{% block body %}
<section class="bg-[#edc75f] min-h-screen text-black pb-28 px-3 pt-5">
    <div class="max-w-md mx-auto">
        <div class="flex items-end justify-between gap-3 mb-4 px-3">
            <h1 class="text-xl font-black uppercase tracking-[-0.04em] text-[#543331]">Membres inscrits</h1>
            <a href="{{ path('admin_members_registered') }}" class="text-[8px] font-black uppercase text-[#543331] border-b border-[#543331] pb-0.5">Inscriptions aux cours</a>
        </div>

        <div class="grid grid-cols-[minmax(0,1fr)_100px] gap-2 mb-3">
            <label class="relative block">
                <span class="sr-only">Rechercher un utilisateur</span>
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <input id="user-search" type="search" placeholder="Rechercher membre…" class="w-full bg-white rounded-md py-2.5 pl-9 pr-2 text-[11px] font-semibold placeholder-gray-500 shadow-sm focus:outline-none focus:ring-2 focus:ring-black/30">
            </label>
            <label class="relative block">
                <span class="sr-only">Type d'utilisateur</span>
                <select id="user-filter" class="appearance-none w-full bg-white rounded-md py-2.5 pl-2.5 pr-7 text-[10px] font-bold shadow-sm focus:outline-none focus:ring-2 focus:ring-black/30 cursor-pointer">
                    <option value="all">Tous</option>
                </select>
                <svg class="absolute right-2.5 top-1/2 -translate-y-1/2 w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
            </label>
        </div>

        <div class="bg-[#050505] rounded-md shadow-xl overflow-hidden min-h-[570px] border border-black px-5 pt-6 pb-8">
            <div class="pb-5 border-b border-[#272727] flex items-center justify-between">
                <h2 class="text-white text-base font-black uppercase tracking-[-0.04em]">Inscrits</h2>
                <span id="user-count" class="bg-[#191713] border border-[#493b18] text-[#edc75f] min-w-[96px] text-center px-2 py-1 text-[8px] font-black uppercase">{{ users|length }} membre{{ users|length > 1 ? 's' : '' }}</span>
            </div>

            <div class="pt-5 space-y-0.5">
                {% for user in users %}
                    <article class="user-row bg-[#242425] border-l-2 border-[#edc75f] px-3 py-3 flex items-center gap-3 hover:bg-[#2c2c2e] transition"
                             data-user="{{ ((user.prenom ?? '') ~ ' ' ~ user.email)|lower|e('html_attr') }}">
                        <div class="w-10 h-10 shrink-0 border border-white/15 bg-[#19191a] flex items-center justify-center text-gray-300">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M15 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2m5-10a4 4 0 100-8 4 4 0 000 8zm7-1l2 2 4-4"/></svg>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-white text-xs font-black truncate">{{ user.prenom ?: 'Utilisateur' }}</h3>
                            <p class="text-[9px] text-[#b8a890] font-bold mt-1 truncate">{{ user.email }}</p>
                        </div>
                        <svg class="w-4 h-4 text-[#d7ad18] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </article>
                {% else %}
                    <p class="py-16 text-center text-xs font-bold text-gray-400">Aucun utilisateur inscrit.</p>
                {% endfor %}
            </div>

            <div id="users-empty" class="hidden py-16 text-center text-xs font-bold text-gray-400">Aucun utilisateur trouvé.</div>
            <div class="text-center pt-5">
                <button id="load-more-users" type="button" class="bg-[#edc75f] hover:bg-[#f4d478] text-[#3e3016] px-9 py-3 text-[9px] font-black uppercase tracking-wide transition">Charger plus</button>
            </div>
        </div>
    </div>
</section>

<script>
function initAdminUsers() {
    const search = document.getElementById('user-search');
    const filter = document.getElementById('user-filter');
    const rows = [...document.querySelectorAll('.user-row')];
    const counter = document.getElementById('user-count');
    const empty = document.getElementById('users-empty');
    const loadMore = document.getElementById('load-more-users');
    const pageSize = 4;
    let limit = pageSize;

    if (!search || !filter || !counter) return;

    const refresh = () => {
        const query = search.value.toLowerCase().trim();
        const matches = rows.filter(row => !query || row.dataset.user.includes(query));

        rows.forEach(row => row.classList.add('hidden'));
        matches.slice(0, limit).forEach(row => row.classList.remove('hidden'));
        counter.textContent = `${matches.length} membre${matches.length > 1 ? 's' : ''}`;
        if (empty) empty.classList.toggle('hidden', matches.length !== 0 || rows.length === 0);
        if (loadMore) loadMore.classList.toggle('hidden', limit >= matches.length);
    };

    search.oninput = () => { limit = pageSize; refresh(); };
    filter.onchange = () => { limit = pageSize; refresh(); };
    if (loadMore) loadMore.onclick = () => { limit += pageSize; refresh(); };
    refresh();
}

document.addEventListener('DOMContentLoaded', initAdminUsers);
document.addEventListener('turbo:load', initAdminUsers);
</script>
{% endblock %}
