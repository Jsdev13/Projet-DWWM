{% extends 'base.html.twig' %}

{% block title %}{{ is_edit ? 'Modifier un cours' : 'Créer un cours' }}{% endblock %}

{% block body %}
<div class="w-full max-w-md mx-auto min-h-screen bg-[#5c3a3a] pb-28">

    {# ===== HEADER : retour + titre ===== #}
    <div class="bg-[#1c1c1e] px-4 py-3.5 flex items-center justify-between sticky top-0 z-30">
        <div class="flex items-center space-x-3">
            <a href="{{ path('app_seance_index') }}" aria-label="Retour aux séances" class="text-white hover:text-[#dfbe6b] transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
            </a>
            <h1 class="text-white font-black text-base tracking-wide">{{ is_edit ? 'Modifier le cours' : 'Créer un cours' }}</h1>
        </div>
        <span class="text-gray-500">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 6a2 2 0 110-4 2 2 0 010 4zm0 8a2 2 0 110-4 2 2 0 010 4zm0 8a2 2 0 110-4 2 2 0 010 4z"/>
            </svg>
        </span>
    </div>

    {# ===== MESSAGES D'ERREUR GLOBAUX ===== #}
    {% if form_errors(form) or not form.vars.valid %}
        {% if form.vars.submitted and not form.vars.valid %}
            <div class="mx-4 mt-4 px-4 py-3 rounded-lg bg-red-100 border border-red-300 text-red-800 text-xs font-semibold">
                Merci de corriger les champs indiqués ci-dessous.
            </div>
        {% endif %}
    {% endif %}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        {# ===== ZONE IMPORT IMAGE ===== #}
        <div class="bg-[#1c1c1e]">
            {# L'input fichier est superposé en transparent par-dessus toute la zone :
               le clic tombe donc directement sur l'input natif, sans dépendre du label ni du JS. #}
            <div id="seance-image-dropzone" class="relative min-h-[220px] flex flex-col items-center justify-center py-6 px-4 hover:bg-[#262628] transition">

                {# Aperçu : remplace le placeholder à la même place une fois un fichier choisi.
                   On pilote la visibilité avec style.display (et non une classe Tailwind)
                   pour ne dépendre d'aucune feuille de style. #}
                <img id="seance-image-preview" src="{{ is_edit and seance.image ? asset('images/seances/' ~ seance.image) : '' }}" alt="Aperçu de l'image du cours"
                    style="display:{{ is_edit and seance.image ? 'block' : 'none' }}"
                    class="w-full max-h-52 object-cover rounded-lg">

                <span id="seance-image-placeholder" class="flex flex-col items-center justify-center" style="display:{{ is_edit and seance.image ? 'none' : 'flex' }}">

                    <svg class="w-12 h-12 text-[#dfbe6b] mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <span class="text-gray-400 text-[11px] tracking-widest uppercase">
                        Cliquez pour importer une image
                    </span>
                </span>

                <span id="seance-image-filename" class="mt-3 block w-full text-center text-[11px] text-[#dfbe6b] truncate"></span>


                {{ form_widget(form.imageFile, {'attr': {
                    'id': 'seance-image-input',
                    'class': 'absolute inset-0 w-full h-full opacity-0 cursor-pointer',
                    'aria-label': 'Importer une image pour le cours',
                    'onchange': 'showSeanceImagePreview(this)'
                }}) }}

            </div>

            {% if form.imageFile.vars.errors|length %}
                <p class="px-4 pb-4 text-[11px] font-semibold text-red-300">{{ form_errors(form.imageFile) }}</p>
            {% endif %}
        </div>



        {# ===== BLOC 1 : INFORMATIONS GENERALES ===== #}
        <div class="px-4 pt-5">
            <h2 class="flex items-center text-white font-black text-[11px] uppercase tracking-widest mb-4">
                <svg class="w-4 h-4 mr-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                INFORMATIONS GÉNÉRALES
            </h2>

            {# NOM DU COURS #}
            <div class="mb-4">
                <label for="{{ form.name.vars.id }}" class="block text-white text-[10px] font-bold uppercase tracking-widest mb-1.5">
                    Nom du cours
                </label>
                {{ form_widget(form.name) }}
                {% if form.name.vars.errors|length %}
                    <p class="mt-1 text-[11px] font-semibold text-red-200">{{ form_errors(form.name) }}</p>
                {% endif %}
            </div>

            {# CATEGORIES #}
            <div class="mb-4">
                <label for="{{ form.categorie.vars.id }}" class="block text-white text-[10px] font-bold uppercase tracking-widest mb-1.5">
                    Catégories
                </label>
                {{ form_widget(form.categorie) }}
                {% if form.categorie.vars.errors|length %}
                    <p class="mt-1 text-[11px] font-semibold text-red-200">{{ form_errors(form.categorie) }}</p>
                {% endif %}
            </div>

            {# NIVEAU #}
            <div class="mb-4">
                <label for="{{ form.level.vars.id }}" class="block text-white text-[10px] font-bold uppercase tracking-widest mb-1.5">
                    Niveau
                </label>
                {{ form_widget(form.level) }}
                {% if form.level.vars.errors|length %}
                    <p class="mt-1 text-[11px] font-semibold text-red-200">{{ form_errors(form.level) }}</p>
                {% endif %}
            </div>

            {# NOM DU COACH #}
            <div class="mb-5">
                <label for="{{ form.coach.vars.id }}" class="block text-white text-[10px] font-bold uppercase tracking-widest mb-1.5">
                    Nom du coach
                </label>
                {{ form_widget(form.coach) }}
                {% if form.coach.vars.errors|length %}
                    <p class="mt-1 text-[11px] font-semibold text-red-200">{{ form_errors(form.coach) }}</p>
                {% endif %}
            </div>
        </div>

        {# ===== BLOC 2 : PLANIFICATION & LIEU ===== #}
        <div class="px-4">
            <h2 class="flex items-center text-white font-black text-[11px] uppercase tracking-widest mb-4">
                <svg class="w-4 h-4 mr-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                PLANIFICATION &amp; LIEU
            </h2>

            {# JOUR + HEURE DEBUT (2 colonnes comme la maquette) #}
            <div class="grid grid-cols-2 gap-3 mb-4">
                <div>
                    <label for="{{ form.date.vars.id }}" class="block text-white text-[10px] font-bold uppercase tracking-widest mb-1.5">
                        Jour
                    </label>
                    {{ form_widget(form.date) }}
                    {% if form.date.vars.errors|length %}
                        <p class="mt-1 text-[11px] font-semibold text-red-200">{{ form_errors(form.date) }}</p>
                    {% endif %}
                </div>
                <div>
                    <label for="{{ form.start_time.vars.id }}" class="block text-white text-[10px] font-bold uppercase tracking-widest mb-1.5">
                        Heure
                    </label>
                    {{ form_widget(form.start_time) }}
                    {% if form.start_time.vars.errors|length %}
                        <p class="mt-1 text-[11px] font-semibold text-red-200">{{ form_errors(form.start_time) }}</p>
                    {% endif %}
                </div>
            </div>

            {# HEURE DE FIN (obligatoire en base, donc affichée) #}
            <div class="mb-4">
                <label for="{{ form.end_time.vars.id }}" class="block text-white text-[10px] font-bold uppercase tracking-widest mb-1.5">
                    Heure de fin
                </label>
                {{ form_widget(form.end_time) }}
                {% if form.end_time.vars.errors|length %}
                    <p class="mt-1 text-[11px] font-semibold text-red-200">{{ form_errors(form.end_time) }}</p>
                {% endif %}
            </div>

            {# LIEU #}
            <div class="mb-4">
                <label for="{{ form.salle.vars.id }}" class="block text-white text-[10px] font-bold uppercase tracking-widest mb-1.5">
                    Lieu
                </label>
                {{ form_widget(form.salle) }}
                {% if form.salle.vars.errors|length %}
                    <p class="mt-1 text-[11px] font-semibold text-red-200">{{ form_errors(form.salle) }}</p>
                {% endif %}
            </div>

            {# PLACE MAXIMUM #}
            <div class="mb-6">
                <label for="{{ form.capacity_max.vars.id }}" class="block text-white text-[10px] font-bold uppercase tracking-widest mb-1.5">
                    Place maximum
                </label>
                {{ form_widget(form.capacity_max) }}
                {% if form.capacity_max.vars.errors|length %}
                    <p class="mt-1 text-[11px] font-semibold text-red-200">{{ form_errors(form.capacity_max) }}</p>
                {% endif %}
            </div>
        </div>

        {# ===== ACTIONS ===== #}
        <div class="px-4 space-y-3">
            <button type="submit"
                class="w-full bg-[#1c1c1e] text-white font-black uppercase text-[11px] tracking-widest py-4 rounded-lg hover:bg-black transition">
                {{ is_edit ? 'Enregistrer les modifications' : 'Enregistrer le cours' }}
            </button>

            <a href="{{ path('app_seance_index') }}"
                class="block w-full text-center bg-white text-gray-900 font-bold uppercase text-[11px] tracking-widest py-4 rounded-lg hover:bg-gray-200 transition">
                Annuler
            </a>
        </div>

    {{ form_end(form) }}

</div>

<script>
// Fonction globale appelée directement par l'attribut onchange de l'input :
// aucun besoin d'attendre DOMContentLoaded ni de gérer les rechargements Turbo.
window.showSeanceImagePreview = function (input) {
    var preview = document.getElementById('seance-image-preview');
    var placeholder = document.getElementById('seance-image-placeholder');
    var filename = document.getElementById('seance-image-filename');

    if (!preview || !placeholder || !filename) {
        return;
    }

    var file = input.files && input.files[0];

    if (!file) {
        preview.src = '';
        preview.style.display = 'none';
        placeholder.style.display = '';
        filename.textContent = '';
        return;
    }

    // On révoque l'URL précédente pour ne pas empiler les blobs en mémoire
    if (preview.dataset.objectUrl) {
        URL.revokeObjectURL(preview.dataset.objectUrl);
    }

    var objectUrl = URL.createObjectURL(file);
    preview.dataset.objectUrl = objectUrl;
    preview.src = objectUrl;
    preview.style.display = 'block';
    placeholder.style.display = 'none';
    filename.textContent = file.name;
};
</script>



{% endblock %}
